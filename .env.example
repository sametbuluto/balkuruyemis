# Yerelde boş bırakın. Yalnızca ürün sahibinin doğruladığı HTTPS origin.
NEXT_PUBLIC_SITE_URL=
# Alan adı tek başına indekslemeyi açmaz. Yayın onayı sonrası true ve yeniden build.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Cloudflare production dalıyla aynı olmalı. CF_PAGES_BRANCH hosting tarafından verilir.
SITE_PRODUCTION_BRANCH=main
